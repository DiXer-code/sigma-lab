# Збірка й артефакти тестів
bin/
obj/
TestResults/
coverage/
coverage-report/
*.coverage
*.trx
__pycache__/

# Локальні дані (файли SQLite, дампи PostgreSQL)
#
# УВАГА: не додавайте тут шаблон *.sqlite. Git на Windows порівнює шляхи без урахування
# регістру, тому *.sqlite збігається з каталогом src/Lab.Migrations.Sqlite і мовчки
# виключає з репозиторію цілий проєкт міграцій. Симптом: локально все збирається, а на CI
# `dotnet restore` падає з «The project file ... was not found».
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite3
*.sqlite-journal

# Секрети й локальні налаштування
.env
.env.local
appsettings.Development.local.json
*.user
*.suo
.vs/
.idea/
.vscode/

# Матеріали кафедри (лекції, PDF) - не публікуються
materials/

# Артефакти MAUI / Android
*.apk
*.aab
*.keystore
